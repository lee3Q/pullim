{
  "name": "pullim",
  "version": "1.0.0",
  "type": "module",
  "description": "Open-source cognitive unraveling & Socratic decision workbench (Web + CLI + TypeScript Engine)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lee3Q/pullim.git"
  },
  "keywords": [
    "decision-making",
    "socratic-questioning",
    "metacognition",
    "implementation-intentions",
    "cognitive-ladder",
    "decision-journal",
    "local-first",
    "open-source"
  ],
  "bin": {
    "pullim": "./bin/pullim.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/ --max-warnings 20",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "cli": "node bin/pullim.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "nanoid": "^5.1.6",
    "next": "16.4.4",
    "openai": "^6.32.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
