{
  "name": "pullim",
  "version": "1.0.0",
  "type": "module",
  "description": "Open-source cognitive unraveling & Socratic decision workbench (Web + CLI + TypeScript Engine)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lee3Q/pullim.git"
  },
  "keywords": [
    "decision-making",
    "socratic-questioning",
    "metacognition",
    "implementation-intentions",
    "cognitive-ladder",
    "decision-journal",
    "local-first",
    "open-source"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "pullim": "./bin/pullim.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node src/server/main.ts",
    "start": "node src/server/main.ts",
    "build": "node scripts/verify-build.mjs build",
    "lint": "node scripts/verify-build.mjs lint",
    "test": "node --test tests/*.test.mjs",
    "cli": "node bin/pullim.mjs"
  }
}
