# Pullim — Environment Variables
# 이 파일을 .env.local로 복사해서 사용하세요:
#   cp .env.example .env.local
# .env.local은 절대 commit하지 마세요.

# ============================================================
# LLM Mode (필수)
# ============================================================
# 기본값: demo — 외부 API 키 없이 실행하기 위한 모드.
# 모든 AI 응답이 mock 데이터로 반환됩니다.
# 실제 AI 응답을 원하면 아래 API 키 중 최소 1개를 설정하세요.
LLM_MODE=demo

# ============================================================
# Anthropic (Claude)
# ============================================================
ANTHROPIC_API_KEY=
PIPELINE_MODEL=claude-sonnet-4-6
ANALYSIS_MODEL=claude-sonnet-4-6
ROUTING_MODEL=claude-haiku-4-6

# ============================================================
# OpenAI (GPT)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# ============================================================
# Google (Gemini)
# ============================================================
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# ============================================================
# GLM (z.ai 게이트웨이)
# ============================================================
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=GLM-5

# ============================================================
# Perplexity (리서치) — experimental
# ============================================================
# Perplexity/research/ultimate pipeline은 실험적 기능입니다.
# API 키가 없으면 데모 리서치 카드가 반환됩니다.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ============================================================
# Local LLM (ollama 등)
# ============================================================
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3:4b

# ============================================================
# Behind-the-scenes LLM (선택)
# ============================================================
# 기본값: false — 외부 LLM 기반 내면사고를 사용하지 않습니다.
# true로 설정하면 행동 신호/대화 맥락이 외부 모델(Gemini)로 전송됩니다.
# GOOGLE_AI_API_KEY가 필요합니다.
ENABLE_BEHIND_LLM=false

# ============================================================
# Supabase (선택)
# ============================================================
# anon key는 public 값이지만, 실제 배포에서는 RLS 정책이 필수입니다.
# 값이 없으면 localStorage로 폴백됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Ads (선택)
# ============================================================
# 기본값: false — 광고 UI가 비활성화됩니다.
NEXT_PUBLIC_ENABLE_ADS=false

# ============================================================
# Hosted Demo (공개 데모 전용)
# ============================================================
# 기본값: false — 일반 개발/로컬 사용.
# true이면 공개 데모 안전 모드: 외부 cloud LLM/Perplexity 호출을 차단하고
# demo/local fallback만 사용합니다.
# maintainer는 API key나 free credit을 제공하지 않습니다.
# 모든 provider key는 optional입니다.
# 실제 API key를 절대 commit하지 마세요.
# 공개 데모는 rate limit/quota 구현 전까지 LLM_MODE=demo를 권장합니다.
PULLIM_HOSTED_DEMO=false
