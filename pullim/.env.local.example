# 필수 — 없으면 데모 모드로만 동작 (실제 AI 응답 불가)
ANTHROPIC_API_KEY=sk-ant-...

# 필수 (운영) — 세션 식별 쿠키와 정책 저장 키의 서명 키
# openssl rand -hex 32 로 생성하고 서버 환경변수에만 보관
PULLIM_POLICY_SECRET=replace-with-a-random-64-character-hex-string
# Required in production: shared Redis REST store for monotonic policy state.
PULLIM_POLICY_REDIS_URL=https://your-redis-rest-endpoint
PULLIM_POLICY_REDIS_TOKEN=replace-with-server-only-token

# 선택 — 없으면 규칙 기반 폴백 (내면사고 기능)
GOOGLE_AI_API_KEY=AIza...

# Supabase (선택 — 없으면 localStorage 폴백, 피드백 수집 불가)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 모델 오버라이드 (선택 — 테스트 시 저가 모델로 전환)
# PIPELINE_MODEL=claude-haiku-4-5-20251001
# ANALYSIS_MODEL=claude-haiku-4-5-20251001
